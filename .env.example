# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...
# api_id / api_hash с https://my.telegram.org (нужны для аккаунта-наблюдателя)
API_ID=12345
API_HASH=0123456789abcdef0123456789abcdef
# Имя файла сессии аккаунта-наблюдателя (создаётся командой python -m giftbot.login)
SESSION=watcher
# Путь к базе
DB_PATH=giftbot.db
# Пауза между полными проходами по коллекциям, сек
POLL_INTERVAL=15
# Пауза между запросами к API, сек (защита от FloodWait)
REQUEST_DELAY=0.35
# Как часто обновлять список коллекций, сек
COLLECTIONS_REFRESH=1800
# Ручные слаги, если автоматический не угадался: "Название=Slug;Другое=Slug2"
SLUG_OVERRIDES=
# ID админов через запятую (команда /stats)
ADMINS=
