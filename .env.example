# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...
# api_id / api_hash с https://my.telegram.org (нужны для аккаунта-наблюдателя)
API_ID=12345
API_HASH=0123456789abcdef0123456789abcdef
# Сессия наблюдателя: файл <SESSION>.session или строка SESSION_STRING (её печатает python -m giftbot.login)
SESSION=watcher
SESSION_STRING=
# ID админов через запятую: служебная статистика в /stats и уведомления о проблемах с аккаунтом
ADMINS=

# --- необязательные настройки ---
DB_PATH=giftbot.db
# Запросов в секунду от наблюдателя (после FloodWait снижается сам и потом восстанавливается)
REQUESTS_PER_SECOND=3
# Интервал опроса коллекции, сек: активные — POLL_MIN, тихие постепенно до POLL_MAX
POLL_MIN=4
POLL_MAX=90
# Как часто обновлять список коллекций, сек
COLLECTIONS_REFRESH=1800
# Сколько дней хранить историю улучшений (для /recent и /top)
KEEP_DAYS=7
# Работать столько секунд и завершиться (0 = бесконечно; используется в GitHub Actions)
RUN_SECONDS=0
# Ручные слаги, если автоматический не подошёл: "Название=Slug;Другое=Slug2"
SLUG_OVERRIDES=
