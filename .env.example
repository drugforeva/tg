# Токен бота от @BotFather — единственное обязательное
BOT_TOKEN=123456:ABC...
# ID админов через запятую. Админ подключает аккаунты-наблюдатели прямо в боте: /accounts
# (номер телефона + код), а ещё получает служебную статистику, тревоги, бэкапы, /broadcast, /refund
ADMINS=

# --- необязательно ---
# Свои api_id / api_hash с https://my.telegram.org. Без них используются публичные ключи Telegram Desktop
API_ID=
API_HASH=
# Дополнительные наблюдатели из настроек (кроме подключённых в боте):
# строки SESSION_STRING (печатает python -m giftbot.login; несколько — через пробел)
# или файлы <SESSION>.session (несколько — через запятую)
SESSION=watcher
SESSION_STRING=
DB_PATH=giftbot.db
# Часовой пояс для ежедневных сводок и бэкапов
TIMEZONE=Europe/Moscow
# Во сколько присылать админам бэкап базы (-1 = не присылать)
BACKUP_HOUR=4
# Адрес Mini App с редактором фильтров, например https://<логин>.github.io/<репозиторий>/
WEBAPP_URL=
# Премиум за Telegram Stars (0 = выключен, всё бесплатно)
PREMIUM_PRICE=0
PREMIUM_DAYS=30
FREE_SUBSCRIPTIONS=2
FREE_TRACKED=3
MAX_SUBSCRIPTIONS=10
MAX_TRACKED=50
# Запросов в секунду на каждый аккаунт-наблюдатель (после FloodWait снижается сам)
REQUESTS_PER_SECOND=3
# Интервал опроса коллекции, сек: активные — POLL_MIN, тихие постепенно до POLL_MAX
POLL_MIN=4
POLL_MAX=90
# Как часто обновлять список коллекций, сек
COLLECTIONS_REFRESH=1800
# Флоры и число лотов на маркете (один запрос на все коллекции), сек
MARKET_REFRESH=30
# Перепроверять ленту продаж коллекции не реже, чем раз в столько секунд
MARKET_POLL_MAX=300
# Как часто проверять подарки из слежки, сек
TRACK_INTERVAL=120
# Сколько дней хранить историю улучшений, лотов и флоров
KEEP_DAYS=7
# Работать столько секунд и завершиться (0 = бесконечно; используется в GitHub Actions)
RUN_SECONDS=0
# Ручные слаги, если автоматический не подошёл: "Название=Slug;Другое=Slug2"
SLUG_OVERRIDES=
